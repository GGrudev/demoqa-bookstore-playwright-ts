# Optional: override default DemoQA credentials used by login/smoke UI tests.
# API tests create isolated users automatically and do not require these values.
#
# Copy this file to .env for local use, or set variables in your shell / CI secrets.
DEMOQA_USERNAME=yourUser
DEMOQA_PASSWORD=YourPass@123

# Optional: select environment config from config/environments.ts (default: dev)
# ENV=dev
