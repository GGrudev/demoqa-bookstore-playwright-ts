# Local overrides loaded automatically by playwright.config.ts (via dotenv).
# Copy this file to `.env`. Do not commit `.env`.
#
#   cp .env.example .env
#
# Required for local smoke, e2e, and authenticated runs. There is no default account
# in the repository. Offline and API-only runs do not read these values.
# In CI, set the same names as repository secrets.
DEMOQA_USERNAME=
DEMOQA_PASSWORD=

# Optional: select environment config from config/environments.ts (default: dev)
# ENV=dev
