# Local overrides loaded automatically by playwright.config.ts (via dotenv).
# API tests create isolated users and do not require DEMOQA_* values.
#
# Copy this file to `.env`:
#   cp .env.example .env
#
# In CI, set DEMOQA_USERNAME / DEMOQA_PASSWORD as repository secrets for
# smoke / e2e / authenticated suites. API-only jobs do not need them.
DEMOQA_USERNAME=yourUser
DEMOQA_PASSWORD=YourPass@123

# Optional: select environment config from config/environments.ts (default: dev)
# ENV=dev
