{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "preserve",
        "resolveJsonModule": true,
        "types": ["node"],
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@components/*": ["./components/*"],
            "@config/*": ["./config/*"],
            "@fixtures/*": ["./fixtures/*"],
            "@pages/*": ["./pages/*"],
            "@schemas/*": ["./schemas/*"],
            "@utils/*": ["./utils/*"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "playwright-report", "test-results"]
}
