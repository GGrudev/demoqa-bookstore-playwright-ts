{
    "name": "demoqa-bookstore",
    "version": "1.0.0",
    "description": "Book Store Test Automation Framework — UI & API Testing with Playwright",
    "scripts": {
        "test": "playwright test --project=offline --project=api --project=chromium --project=authenticated",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "test:e2e": "playwright test --project=chromium --project=authenticated",
        "test:api": "playwright test --project=api",
        "test:offline": "playwright test --project=offline",
        "test:cross-browser": "playwright test --project=firefox --project=webkit",
        "test:smoke": "playwright test --project=api --project=chromium --project=authenticated --grep @smoke",
        "test:regression": "playwright test",
        "test:e2e:shard:1": "playwright test --project=chromium --project=authenticated --shard=1/2",
        "test:e2e:shard:2": "playwright test --project=chromium --project=authenticated --shard=2/2",
        "test:health": "node scripts/run-demoqa-health.mjs",
        "test:report": "playwright show-report",
        "test:report:merge": "playwright merge-reports --config=playwright.config.ts ./all-blob-reports",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"**/*.{ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,json,md}\""
    },
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "playwright",
        "test-automation",
        "e2e-testing",
        "api-testing",
        "typescript",
        "demoqa",
        "bookstore"
    ],
    "author": "GGrudev",
    "license": "MIT",
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.63.0",
        "@types/node": "^24.19.0",
        "dotenv": "^18.0.7",
        "eslint": "^10.11.0",
        "eslint-plugin-playwright": "^2.12.1",
        "prettier": "^3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.71.2",
        "zod": "^4.6.5"
    }
}
