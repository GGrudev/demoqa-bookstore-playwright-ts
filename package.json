{
    "name": "demoqa-bookstore",
    "version": "1.0.0",
    "description": "Book Store Test Automation Framework — UI & API Testing with Playwright",
    "scripts": {
        "test": "playwright test --project=offline --project=api --project=chromium --project=authenticated",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "test:e2e": "playwright test --project=chromium --project=authenticated",
        "test:api": "playwright test --project=api",
        "test:offline": "playwright test --project=offline",
        "test:cross-browser": "playwright test --project=firefox --project=webkit",
        "test:smoke": "playwright test --project=api --project=chromium --project=authenticated --grep @smoke",
        "test:regression": "playwright test",
        "test:shard:1": "playwright test --shard=1/2",
        "test:shard:2": "playwright test --shard=2/2",
        "test:report": "playwright show-report",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"**/*.{ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,json,md}\""
    },
    "engines": {
        "node": ">=20.19"
    },
    "keywords": [
        "playwright",
        "test-automation",
        "e2e-testing",
        "api-testing",
        "typescript",
        "demoqa",
        "bookstore"
    ],
    "author": "GGrudev",
    "license": "MIT",
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "1.58.2",
        "@types/node": "^22.13.1",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.5",
        "eslint-plugin-playwright": "^2.10.5",
        "prettier": "^3.0.0",
        "typescript": "7.0.2",
        "typescript-eslint": "^8.67.0",
        "zod": "^4.4.3"
    }
}
